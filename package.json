{
  "name": "godot-mcp-server",
  "version": "0.0.1",
  "description": "TypeScript MCP server that bridges Claude Code to the Godot 4.x editor via the companion godot-mcp-toolkit plugin (localhost WebSocket on 127.0.0.1:6505).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "godot-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NPGameDev/godot-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/NPGameDev/godot-mcp-server/issues"
  },
  "homepage": "https://github.com/NPGameDev/godot-mcp-server#readme",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "godot",
    "claude",
    "model-context-protocol"
  ],
  "author": "NPGameDev",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  }
}
